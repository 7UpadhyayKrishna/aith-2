# Copy to .env and fill for production. Never commit real secrets.

# --- Required ---
# Supabase Postgres URI (Direct db.<ref>.supabase.co:5432 or Session pooler :5432).
# If the password contains @ # : etc., URL-encode it OR keep as-is — the app parses user/password safely.
# Example direct: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# Example pooler: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=
# Optional: DATABASE_POOLER_HOST=aws-0-ap-south-1.pooler.supabase.com  (rewrites db.<ref> → pooler)
# Optional: SUPABASE_PROJECT_REF=<ref>  (helps pooler username postgres.<ref> when needed)
# Prefer Session pooler URI in production (IPv4). Direct db.<ref>.supabase.co can be IPv6-only.
# Optional: DATABASE_SSL=verify | require | insecure | disable
#   production: disable forbidden; prefer verify; default for Supabase encrypts without CA verify
# Optional pool caps (Supabase free/pro connection budget): DATABASE_POOL_MIN=1 DATABASE_POOL_MAX=5

# Comma-separated origins. Use explicit production hosts — NEVER * in production.
# Example: https://www.aithworld.com,https://aithworld.com
CORS_ORIGINS=http://localhost:3000

# --- Optional ops email (DB insert always succeeds first; SMTP never blocks the user) ---
# If none of these are set → notification-disabled mode (enquiries still stored).
# If some are set but OPS_NOTIFICATION_EMAIL + SMTP_HOST + SMTP_FROM are incomplete → startup WARNING.
OPS_NOTIFICATION_EMAIL=ops@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true

# --- Admin CMS ---
# REQUIRED in production (APP_ENV=production): cryptographically random ≥32 characters.
# Changing this invalidates all admin sessions. See docs/PRODUCTION_RUNBOOK.md for rotation.
# Required in production (≥32 chars). In local development only, unset falls back to a
# persisted backend/.admin_session_secret file (never used when APP_ENV=production —
# startup fails closed). Do not rely on generated-on-every-boot secrets in production.
ADMIN_SESSION_SECRET=

# Internal ops attention thresholds (NOT contractual customer SLA)
# OPS_ENQUIRY_NEW_HOURS=24
# OPS_QUOTE_UNASSIGNED_HOURS=48
# OPS_CAREER_UNTOUCHED_DAYS=3
# REQUIRED true behind HTTPS in production (startup fails if APP_ENV=production and this is false)
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAMESITE=lax
# Password policy: min 15 / max 128 by default (passphrases).
# ADMIN_MIN_PASSWORD_LENGTH=15
# ADMIN_MAX_PASSWORD_LENGTH=128
# Optional TOTP MFA (pyotp). Off by default for soft launch; enable when ready.
ADMIN_MFA_ENABLED=false
ADMIN_MFA_REQUIRED=false
# Public site origin used in blog sitemap / canonicals
SITE_ORIGIN=https://www.aithworld.com
APP_ENV=development
# Optional build identifier exposed on /api/health and Admin → System
# APP_VERSION=
# GIT_SHA=
# Media: url_only (default). Do not upload to ephemeral disk.
MEDIA_PROVIDER=url_only
# Only honour X-Forwarded-For when sitting behind a trusted reverse proxy / CDN
TRUST_PROXY_HEADERS=false

# Notes:
# - From must be the authenticated sender; Reply-To is set to the customer email.
# - In-memory rate limit is 8 submissions / IP / 60s per process (+ login account bucket).
# - Prefer Nginx / Cloudflare rate limits for multi-instance deploys.
# - Health: GET /api/health
# - Apply schema: python scripts/apply_schema.py (also runs on API startup)
# - Create admin: python scripts/create_admin.py
# - Reset password: python scripts/reset_admin_password.py
# - Disable admin: python scripts/disable_admin.py
# - Flag legacy passwords: python scripts/mark_legacy_passwords.py --apply
# - Seed blogs: python scripts/seed_blogs.py
# - Dynamic sitemap: GET /api/blog-sitemap.xml (proxy /blog-sitemap.xml → API in production)
# - See frontend/vercel.json.example for rewrite template
# - Legacy MONGO_URL / DB_NAME are no longer used.
